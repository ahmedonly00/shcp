# ─────────────────────────────────────────────────────────────
# SHCP Environment Variables — copy to .env and fill in values
# NEVER commit .env to version control
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
DB_PASSWORD=change_me_strong_password

# ── JWT ───────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_256bit_hex_secret_at_least_64_chars_long_here

# ── Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_password

# ── RabbitMQ ──────────────────────────────────────────────────
RABBITMQ_PASS=change_me_rabbitmq_password

# ── Frontend URL (CORS) ───────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── JavaMail / SMTP ───────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_app_password

# ── Firebase FCM (Push Notifications) ────────────────────────
# Place firebase-adminsdk.json in ./secrets/
FCM_CREDENTIALS_PATH=/secrets/firebase-adminsdk.json

# ── coturn TURN server ────────────────────────────────────────
# Generate with: openssl rand -hex 32
# Must match `static-auth-secret` in coturn/turnserver.conf
COTURN_SECRET=change_me_generate_with_openssl_rand_hex_32
COTURN_HOST=your_server_public_ip_or_domain
COTURN_PORT=3478
COTURN_TLS_PORT=5349
COTURN_REALM=shcp.rw
